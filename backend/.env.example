# mtb-skills backend (backend/app) -- environment configuration.
#
# Copy to `.env` in backend/ (or the repo root -- python-dotenv's
# load_dotenv() searches upward from the cwd) and fill in real values for
# local dev; it's auto-loaded on startup (see app/config.py). Never commit
# `.env` -- it's gitignored. Cloud Run reads these as real environment
# variables / Secret Manager references instead (see
# docs/PHASE3_INFRA_SETUP.md); no .env file exists in the deployed image.

# --- required, fail-fast if missing -----------------------------------------

# Supabase connection string. Use the TRANSACTION POOLER (pgbouncer,
# port 6543) for app traffic -- the DB layer landing in a later increment
# disables prepared statements (psycopg's prepare_threshold=None) to work
# with it, mirroring swim-coach's DbStore. Use the DIRECT connection
# (port 5432) only for migrations/DDL, never for the running service.
#   postgresql://postgres.<project-ref>:<pw>@<region>.pooler.supabase.com:6543/postgres
# SECRET -- never commit a real value.
DATABASE_URL=

# Signs/verifies the backend's own session tokens once the 3.1 auth routes
# land (Supabase Auth + RLS). Choose a long random value, e.g.
# `openssl rand -hex 32`. SECRET -- never commit a real value.
SESSION_SECRET=

# The OAuth client id Google ID tokens must carry as `aud`, verified
# server-side once the 3.1 auth routes land. PUBLIC -- this is the SAME
# value the frontend bakes into its build as VITE_GOOGLE_CLIENT_ID (a GitHub
# Actions *variable*, not a secret -- see
# docs/PHASE3_TEAM_VISIBILITY_PLAN.md's "AuthN" section). Still required at
# startup: without it, there's no audience to check a token against later.
GOOGLE_CLIENT_ID=

# The Supabase project URL (same value as the frontend's VITE_SUPABASE_URL),
# e.g. https://<ref>.supabase.co. REQUIRED. Used to build the JWKS URL so the
# backend can verify Supabase's ASYMMETRIC (ES256) session tokens -- what new
# projects issue by default (see backend/app/auth.py). NOT a secret.
SUPABASE_URL=

# --- optional, sensible defaults shown --------------------------------------

# Legacy HS256 shared secret (Supabase -> Settings -> API -> JWT Settings ->
# JWT Secret). OPTIONAL -- only needed if your project still signs tokens with
# the legacy HS256 secret. Projects on the newer asymmetric keys verify via
# the JWKS URL derived from SUPABASE_URL and need NOT set this. SECRET when set.
SUPABASE_JWT_SECRET=

# HTTP port uvicorn binds to. Cloud Run injects its own PORT at deploy time.
PORT=8000

# Comma-separated list of allowed CORS origins for the PWA, e.g.
#   ALLOWED_ORIGINS=https://ashaber.github.io,https://mtb-web-itg.example.com
# Empty by default (no cross-origin access) until an environment's frontend
# origin is configured.
ALLOWED_ORIGINS=

# Persistence backend flag. "db" (default) -- Supabase, via the DB layer
# landing in a later increment. See app/config.py's Settings.store_backend
# docstring.
STORE_BACKEND=db

# How long a minted session token stays valid before a coach has to sign in
# again, once the 3.1 auth routes mint one.
SESSION_TTL_DAYS=30

# Structured-logger level (app/logging.py). One of debug/info/warn/error.
LOG_LEVEL=info

# --- set by the deploy workflow, not documented here as required ------------

# APP_VERSION and GIT_SHA (both read directly by app/main.py's /version
# route) are set as Cloud Run --set-env-vars at deploy time, not filled in
# here -- see docs/PHASE3_TEAM_VISIBILITY_PLAN.md's "Deploy pins the SHA tag
# for inspectable rollbacks."
